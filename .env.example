# PostgreSQL connection (Supabase transaction pooler supported, TLS required remotely)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fee_tracker
# Public canonical origin; no trailing slash
SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Must match deployed hostname; validates Turnstile hostname and action
TURNSTILE_HOSTNAME=localhost
# Generate both independently; minimum 32 random characters
ANTI_ABUSE_SECRET=
ADMIN_SESSION_SECRET=
# npm run admin:hash (reads password interactively)
ADMIN_PASSWORD_HASH=
NORMAL_FEE_MAX=10000
LEADERBOARD_MIN_REPORTS=5
# Development only; ignored in NODE_ENV=production
DEV_BYPASS_TURNSTILE=false
# Integration tests and seeds require a separate development database
TEST_DATABASE_URL=

# Workers local development: use a disposable local PostgreSQL DB, never production.
# Also accepted by vite dev/preview in place of Hyperdrive's configured local URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@127.0.0.1:5432/fee_tracker
# Production release settings (prefer GitHub production environment, not local files).
# Supabase DIRECT PostgreSQL URL stays in Hyperdrive and GitHub migration secret only.
# The Worker receives HYPERDRIVE.connectionString; it does NOT need DATABASE_URL.
ENABLE_PRODUCTION_DEPLOY=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HYPERDRIVE_ID=
DEPLOYMENT_TARGET=cloudflare
# Read-only post-deployment smoke; must equal the configured SITE_URL.
DEPLOYMENT_URL=
